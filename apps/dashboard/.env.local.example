# true: in-memory demo data and mock sign-in. false: Nhost Auth and functions.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Public Nhost endpoints. Never put the admin secret here.
# Local:  https://local.auth.local.nhost.run/v1
# Cloud:  https://<subdomain>.auth.<region>.nhost.run/v1
NEXT_PUBLIC_NHOST_AUTH_URL=https://local.auth.local.nhost.run/v1
NEXT_PUBLIC_NHOST_FUNCTIONS_URL=https://local.functions.local.nhost.run/v1
